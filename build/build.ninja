build example_glfw_vulkan: CXX_EXECUTABLE_LINKER__example_glfw_vulkan_Debug CMakeFiles/example_glfw_vulkan.dir/src/main.cpp.o CMakeFiles/example_glfw_vulkan.dir/ext/imgui/backends/imgui_impl_glfw.cpp.o CMakeFiles/example_glfw_vulkan.dir/ext/imgui/backends/imgui_impl_vulkan.cpp.o CMakeFiles/example_glfw_vulkan.dir/ext/imgui/imgui.cpp.o CMakeFiles/example_glfw_vulkan.dir/ext/imgui/imgui_draw.cpp.o CMakeFiles/example_glfw_vulkan.dir/ext/imgui/imgui_demo.cpp.o CMakeFiles/example_glfw_vulkan.dir/ext/imgui/imgui_tables.cpp.o CMakeFiles/example_glfw_vulkan.dir/ext/imgui/imgui_widgets.cpp.o | binary_dir/src/libglfw3.a /usr/lib/libvulkan.so /usr/lib/librt.a /usr/lib/libm.so || binary_dir/src/libglfw3.a
  CONFIG = Debug
  DEP_FILE = CMakeFiles/example_glfw_vulkan.dir/link.d
  FLAGS = -DVK_PROTOTYPES -g
  LINK_FLAGS = -Wl,--dependency-file=CMakeFiles/example_glfw_vulkan.dir/link.d
  LINK_LIBRARIES = binary_dir/src/libglfw3.a  /usr/lib/libvulkan.so  /usr/lib/librt.a  -lm  -ldl
  OBJECT_DIR = CMakeFiles/example_glfw_vulkan.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_FILE = example_glfw_vulkan
  TARGET_PDB = example_glfw_vulkan.dbg
  TARGET_SUPPORT_DIR = CMakeFiles/example_glfw_vulkan.dir


